{
    "name": "Hoot fix",
    "manifest_version": 3,
    "version": "1.1",
    "description": "cs rules hootsuite",
    "permissions": ["storage", "tabs"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://hootsuite.com/*"],
        "css": ["myStyles.css"],
        "js": ["contentScript.js"]
      }
    ]
}